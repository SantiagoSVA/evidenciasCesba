<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="REGISTRO VISUAL"
                android:textColor="#A9DAD5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Evidencias\nfotográficas"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Documenta cada captura con contexto y consérvala en tu galería."
                android:textColor="#D8E8F0"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtContador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="fotografías\nregistradas"
                    android:textColor="#D8E8F0"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Estado: pendiente de fotografía"
                android:textColor="#A9DAD5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCompartirEvidencias"
                style="@style/ButtonEvidencia.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Compartir evidencias" />

            <Button
                android:id="@+id/btnGenerarFicha"
                style="@style/ButtonEvidencia.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Generar ficha de evidencias" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  Captura"
                android:textColor="#173552"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="La fotografía se añade a la evidencia al guardarla."
                android:textColor="#68798B"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="235dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/photo_frame">

                <ImageView
                    android:id="@+id/imgFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Vista previa de la fotografía"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtSinFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Tu próxima evidencia\ncomienza con una foto"
                    android:textColor="#688097"
                    android:textSize="16sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fecha de captura: —"
                    android:textColor="#526273"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtHora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Hora de captura: —"
                    android:textColor="#526273"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnTomarFoto"
                style="@style/ButtonEvidencia.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tomar fotografía" />

            <Button
                android:id="@+id/btnTomarOtra"
                style="@style/ButtonEvidencia.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tomar otra fotografía" />

            <Button
                android:id="@+id/btnEliminarFoto"
                style="@style/ButtonEvidencia.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Eliminar foto actual" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  Datos de la evidencia"
                android:textColor="#173552"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Título"
                android:textColor="#526273"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="Ej. Inspección de entrada"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="#263746"
                android:textColorHint="#8392A3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descripción"
                android:textColor="#526273"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="Describe lo que muestra la foto"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minLines="4"
                android:padding="14dp"
                android:textColor="#263746"
                android:textColorHint="#8392A3" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/ButtonEvidencia.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Guardar evidencia" />

            <Button
                android:id="@+id/btnGuardarFoto"
                style="@style/ButtonEvidencia.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Guardar fotografía en el dispositivo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03  Evidencias guardadas"
                android:textColor="#173552"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Abre la galería para consultar fichas, exportar fotografías o eliminar registros."
                android:textColor="#68798B"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGaleria"
                style="@style/ButtonEvidencia.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ver galería de evidencias" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
