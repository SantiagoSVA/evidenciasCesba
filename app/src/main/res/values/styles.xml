<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Evidencias" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#204A74</item>
        <item name="colorPrimaryDark">#173552</item>
        <item name="colorAccent">#167B74</item>
        <item name="android:statusBarColor">#173552</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#F5F7FA</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="ButtonEvidencia" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="ButtonEvidencia.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="ButtonEvidencia.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">#17645F</item>
    </style>
    <style name="ButtonEvidencia.Neutral">
        <item name="android:background">@drawable/bg_button_neutral</item>
        <item name="android:textColor">#204A74</item>
    </style>
    <style name="ButtonEvidencia.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">#A6382B</item>
    </style>
</resources>
